# Copy to .env on the VPS and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
API_DOMAIN=api.example.org
ADMIN_DOMAIN=admin.example.org
ACME_EMAIL=you@example.org
API_IMAGE=ghcr.io/streamdek/bible-api:latest

# Off-site backups to Cloudflare R2 (used by scripts/backup.sh via rclone)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=bible-backups
