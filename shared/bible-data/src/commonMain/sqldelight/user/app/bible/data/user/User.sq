-- user.db: everything the reader creates on this device. Works with no account. Phase 7 adds a change log
-- for sync; every row already carries updated_at (epoch milliseconds) for that.

CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- Where each reading source was left, as a canonical verse id (BBCCCVVV). Source "feed" is free reading.
CREATE TABLE reading_position (
    source TEXT NOT NULL PRIMARY KEY,
    verse_id INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- One highlight colour per verse. color is an index into the app's highlight palette.
CREATE TABLE highlight (
    verse_id INTEGER NOT NULL PRIMARY KEY,
    color INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE bookmark (
    verse_id INTEGER NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL
);

-- One note per verse for now.
CREATE TABLE note (
    verse_id INTEGER NOT NULL PRIMARY KEY,
    body TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

settingValue:
SELECT value FROM setting WHERE key = ?;

putSetting:
INSERT OR REPLACE INTO setting(key, value) VALUES (?, ?);

position:
SELECT verse_id FROM reading_position WHERE source = ?;

putPosition:
INSERT OR REPLACE INTO reading_position(source, verse_id, updated_at) VALUES (?, ?, ?);

highlightsBetween:
SELECT verse_id, color FROM highlight WHERE verse_id BETWEEN ? AND ?;

putHighlight:
INSERT OR REPLACE INTO highlight(verse_id, color, updated_at) VALUES (?, ?, ?);

removeHighlight:
DELETE FROM highlight WHERE verse_id = ?;

bookmarksBetween:
SELECT verse_id FROM bookmark WHERE verse_id BETWEEN ? AND ?;

allBookmarks:
SELECT verse_id, created_at FROM bookmark ORDER BY created_at DESC;

putBookmark:
INSERT OR REPLACE INTO bookmark(verse_id, created_at) VALUES (?, ?);

removeBookmark:
DELETE FROM bookmark WHERE verse_id = ?;

notesBetween:
SELECT verse_id, body FROM note WHERE verse_id BETWEEN ? AND ?;

allNotes:
SELECT verse_id, body, updated_at FROM note ORDER BY updated_at DESC;

noteCreatedAt:
SELECT created_at FROM note WHERE verse_id = ?;

putNote:
INSERT OR REPLACE INTO note(verse_id, body, created_at, updated_at) VALUES (?, ?, ?, ?);

removeNote:
DELETE FROM note WHERE verse_id = ?;

-- ---- Word study (added in schema version 2, see migrations/1.sqm) ---------------------------------------------

-- Words the reader saved. entry is a Strong's id ("H430", "G26") or a STEP id ("H1254A"); the lemma and language
-- are kept so the list shows even before study.db opens. verse_id is where it was saved from (0 = none).
CREATE TABLE saved_word (
    entry TEXT NOT NULL PRIMARY KEY,
    source TEXT NOT NULL,
    lang TEXT NOT NULL,
    lemma TEXT NOT NULL,
    gloss TEXT NOT NULL,
    verse_id INTEGER NOT NULL,
    note TEXT NOT NULL,
    favorite INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Recently studied words, newest first; one row per entry.
CREATE TABLE study_history (
    entry TEXT NOT NULL PRIMARY KEY,
    lang TEXT NOT NULL,
    lemma TEXT NOT NULL,
    gloss TEXT NOT NULL,
    verse_id INTEGER NOT NULL,
    viewed_at INTEGER NOT NULL
);

savedWords:
SELECT * FROM saved_word ORDER BY created_at DESC;

savedWord:
SELECT * FROM saved_word WHERE entry = ?;

putSavedWord:
INSERT OR REPLACE INTO saved_word(entry, source, lang, lemma, gloss, verse_id, note, favorite, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

removeSavedWord:
DELETE FROM saved_word WHERE entry = ?;

recentStudies:
SELECT * FROM study_history ORDER BY viewed_at DESC LIMIT ?;

putStudy:
INSERT OR REPLACE INTO study_history(entry, lang, lemma, gloss, verse_id, viewed_at) VALUES (?, ?, ?, ?, ?, ?);

trimStudies:
DELETE FROM study_history WHERE entry NOT IN (SELECT entry FROM study_history ORDER BY viewed_at DESC LIMIT ?);
